{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ultimate-tic-tac-toe",
  "main": "cloudflare/index.js",
  "compatibility_date": "2026-11-23",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
